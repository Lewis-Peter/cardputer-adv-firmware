// 复制这个文件成 secrets.h（同目录），填真实值。secrets.h 已经在 .gitignore 里，
// 不会被提交进仓库——千万别把真实 API key 直接改进这个 .example 文件里。
#pragma once
// 这些常量按需使用：某个 .cpp 只用得到其中一两个，剩下的会被 -Wall 报"定义了但没用"。
// 显式标 unused 把这条噪音关掉（框架是 C++11/14，用不了 inline 变量）。

static const char* CHAT_BASE_URL __attribute__((unused)) = "https://api.openai.com";   // 不带末尾斜杠，代码会拼 /v1/chat/completions
static const char* CHAT_API_KEY __attribute__((unused))  = "sk-REPLACE-ME";
static const char* CHAT_MODEL __attribute__((unused))    = "gpt-4o-mini";

// Chat 的根证书（可选，但强烈建议配）。留空 = 不校验证书（client.setInsecure()），
// 而 Chat 请求的 Authorization 头里带着上面那把 key——不校验就意味着中间人能直接拿走它。
// 填法：拿到 CHAT_BASE_URL 那个域名的根 CA，PEM 原样贴进来，例如
//   openssl s_client -showcerts -connect api.openai.com:443 </dev/null
// 把链条最后一张（根）的 -----BEGIN/END CERTIFICATE----- 整段贴成 R"( ... )"。
// ⚠️ 根证书会过期，到期后设备会连不上 Chat（其它功能不受影响）——到时候换一张新的。
static const char* CHAT_ROOT_CA __attribute__((unused)) = "";

// 没配 CHAT_ROOT_CA 时是否允许降级成"不校验证书"。默认 false = 直接拒绝请求，
// 因为这条请求的 Authorization 头里带着上面那把 key，不校验就等于把它交给中间人。
// 只有在你清楚风险、且网络可信（比如自家局域网调试）时才改成 true。
static const bool CHAT_ALLOW_INSECURE __attribute__((unused)) = false;

// SSH 的连接信息在设备上填、存 NVS，不放这里（跟 secrets.h 解耦）。

// 卫星过顶（Sats app）：N2YO 免费 key，注册 https://www.n2yo.com/api/ 即可拿。
// 留空字符串时 Sats 页会提示"未配置 key"而不是报网络错。
static const char* N2YO_API_KEY __attribute__((unused)) = "";

// 路由器监控（Router app）：Clash / mihomo 的外部控制接口。
// CLASH_BASE 形如 http://192.168.50.1:9990（不带末尾斜杠）；CLASH_SECRET 是 external-controller 的 secret。
static const char* CLASH_BASE __attribute__((unused))   = "http://192.168.1.1:9090";
static const char* CLASH_SECRET __attribute__((unused)) = "REPLACE-ME";
// CLASH_PROXY_GROUP 是要跟踪的代理选择组名称；默认不匹配时请检查自己的 Clash 配置中的分组名称。
static const char* CLASH_PROXY_GROUP __attribute__((unused)) = "Proxy";

// GitHub 贡献热力图（GitHub app）：填你的用户名即可，这个接口不需要 token。
// 留空的话页面会提示没配用户名。
static const char* GITHUB_USER __attribute__((unused)) = "";
